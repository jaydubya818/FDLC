%% D29 Production promotion pipeline (Observe → Propose → Evaluate → Qualify → Approve → Promote → Observe)
%% Type: flow · Page: /architecture/factory-versioning
flowchart LR
  O1["Observe<br/>outcomes · incidents · cost"] --> P["Propose<br/>Improvement Candidate"]
  P --> E["Evaluate<br/>regression · held-out · adversarial"]
  E --> Q["Qualify<br/>candidate Factory Version for scope"]
  Q --> A["Approve<br/>Decision: promotion"]:::human
  A --> PR["Promote / Activate<br/>environment · cohort · restoration target"]
  PR --> O2["Observe<br/>window · thresholds"]
  O2 -- "thresholds fail" --> R["Restore<br/>Decision: restoration → previous version"]:::human
  O2 -- "thresholds hold" --> O1
  R --> O1
  N["Never mutate an Active version. Promotion targets an exact digest; restoration targets a separately identified previous version."]:::neutral
  class O1,O2,P learning
  class E,Q,A trust
  class PR,R control
