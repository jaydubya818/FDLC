%% D10 Three-level routing
%% Type: flow · Hero SVG: svg/D10.svg · Page: /architecture/routing
flowchart TB
  OBJ["Objective"] --> L1["Level 1 — Objective routing<br/>Objective Planner (control plane)"]
  L1 --> CAP["Required capabilities → factory set<br/>+ dependency graph across Work Orders"]
  CAP --> WO["Work Order"]
  WO --> L2["Level 2 — Work Order routing<br/>Factory Router"]
  L2 --> ELIG["Eligibility filter (before ranking)<br/>policy · authorization · compatibility · qualification · authority"]
  ELIG -- "eligible set" --> RANK["Rank by evidence<br/>quality · reliability · latency · cost per verified outcome"]
  ELIG -- "empty set" --> BLOCK["Blocked / escalate<br/>never relax a gate · critical never auto-routed"]:::human
  RANK --> FV["qualified Factory Version + Execution Profile<br/>(immutable composition)"]
  FV --> SCHED["Scheduling — a separate decision<br/>capacity · fairness · leases"]
  SCHED --> TASK["Task"]
  TASK --> L3["Level 3 — Task routing<br/>Capability Router inside the factory"]
  L3 --> RES["model route · skill · tool · runtime · sandbox · provider<br/>within the Execution Profile's admitted set"]
  RES --> ATT["Attempt with frozen routing snapshot"]
  class OBJ,WO,TASK intent
  class L1,CAP,L2,ELIG,RANK,SCHED,L3 control
  class FV,RES,ATT execution
  class BLOCK trust
