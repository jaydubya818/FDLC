%% D15 Verification hierarchy (local → global) + orthogonal factory qualification
%% Type: architecture · Page: /architecture/verification
flowchart TB
  T["Task verification<br/>one step's output — fast, local, often deterministic"] --> W["Work Order verification — the unit of acceptance<br/>independent Verification Attempt on the exact Candidate"]
  W --> O["Objective / Integration verification<br/>integrated Candidate across Work Orders and factories"]
  O --> R["Release verification<br/>environment validation · canary · production verification window"]
  Q["Factory qualification (orthogonal axis)<br/>verifies the factory, not the work"] -.-> T
  Q -.-> W
  Q -.-> O
  Q -.-> R
  RULES["Execution success ≠ Task success ≠ Verification success ≠ Business outcome<br/>Independence proven by lineage and by standard · currentness: newest exact-bound verification decides"]:::neutral
  class T,W,O,R trust
  class Q control
