  end
  BROKER["Credential broker"] -- "short-lived, Attempt-scoped" --> SB
  SB -- "egress allowlist only" --> NET["Package registries · shared dev services"]
  SB -. "signed, content-addressed result bundle" .-> Q["Quarantine"]
