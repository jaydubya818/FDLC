{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fdlc.ai/schemas/v1/outcome.schema.json",
  "title": "FDLC Outcome",
  "description": "The observed technical, operational, and business result over an observation window, attributed to the release and its cost cohort. Merge is not an outcome; the clock stops on verified value.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "type": {
      "type": "string",
      "const": "fdlc://v1/outcome"
    },
    "id": {
      "$ref": "#/$defs/Id"
    },
    "namespace": {
      "$ref": "#/$defs/Namespace"
    },
    "releaseId": {
      "$ref": "#/$defs/Id"
    },
    "releaseDigest": {
      "$ref": "#/$defs/Digest"
    },
    "intentId": {
      "$ref": "#/$defs/Id"
    },
    "workOrderIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Id"
      }
    },
    "candidateId": {
      "$ref": "#/$defs/Id"
    },
    "observationWindow": {
      "type": "object",
      "properties": {
        "start": {
          "$ref": "#/$defs/Timestamp"
        },
        "end": {
          "$ref": "#/$defs/Timestamp"
        },
        "status": {
          "type": "string",
          "enum": [
            "OPEN",
            "CLOSED",
            "EXTENDED"
          ]
        },
        "extendedReason": {
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "status"
      ],
      "additionalProperties": false
    },
    "measurementContract": {
      "type": "object",
      "description": "Declared before observation. Metrics observed outside the contract are advisory.",
      "properties": {
        "contractId": {
          "$ref": "#/$defs/Id"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "metricId": {
                "$ref": "#/$defs/Id"
              },
              "name": {
                "type": "string"
              },
              "unit": {
                "type": "string"
              },
              "dimension": {
                "type": "string",
                "enum": [
                  "TECHNICAL",
                  "OPERATIONAL",
                  "BUSINESS",
                  "ECONOMIC"
                ]
              },
              "baseline": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "target": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "direction": {
                "type": "string",
                "enum": [
                  "LOWER_IS_BETTER",
                  "HIGHER_IS_BETTER",
                  "WITHIN_BAND"
                ]
              },
              "rollbackThreshold": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "source": {
                "type": "string"
              }
            },
            "required": [
              "metricId",
              "name",
              "unit",
              "dimension",
              "direction"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "contractId",
        "digest",
        "metrics"
      ],
      "additionalProperties": false
    },
    "measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "metricId": {
            "$ref": "#/$defs/Id"
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": "string"
          },
          "observedAt": {
            "$ref": "#/$defs/Timestamp"
          },
          "source": {
            "type": "string"
          },
          "evidenceId": {
            "$ref": "#/$defs/Id"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "HIGH",
              "LOW",
              "NONE"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "MEASURED",
              "ESTIMATED",
              "UNKNOWN"
            ]
          }
        },
        "required": [
          "metricId",
          "value",
          "observedAt",
          "source",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "technical": {
      "type": "object",
      "properties": {
        "healthChecksPassed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "errorRateDelta": {
          "type": [
            "number",
            "null"
          ]
        },
        "latencyP95DeltaMs": {
          "type": [
            "number",
            "null"
          ]
        },
        "canaryComparison": {
          "type": "string",
          "enum": [
            "WITHIN_BAND",
            "REGRESSED",
            "IMPROVED",
            "INCONCLUSIVE",
            "NOT_RUN"
          ]
        }
      },
      "additionalProperties": false
    },
    "operational": {
      "type": "object",
      "properties": {
        "rolledBack": {
          "type": "boolean"
        },
        "hotfixRequired": {
          "type": "boolean"
        },
        "incidentIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "escapedDefects": {
          "type": [
            "integer",
            "null"
          ]
        },
        "reopenCount": {
          "type": [
            "integer",
            "null"
          ]
        },
        "humanReviewMinutes": {
          "type": [
            "number",
            "null"
          ]
        },
        "changeFailure": {
          "type": "boolean",
          "description": "True if the deployment required rollback, hotfix, or caused a customer-impacting regression within the window."
        }
      },
      "required": [
        "rolledBack",
        "hotfixRequired",
        "changeFailure"
      ],
      "additionalProperties": false
    },
    "business": {
      "type": "object",
      "properties": {
        "valueMeasureIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "valueConfirmed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "leadTimeToValidatedValueMs": {
          "type": [
            "integer",
            "null"
          ],
          "description": "From Intent admittedAt to validated customer value; null until confirmed."
        }
      },
      "additionalProperties": false
    },
    "cost": {
      "type": "object",
      "description": "Cost per accepted/released outcome. Includes failed and retried Attempt spend. Unknown cost stays null with coverage impact.",
      "properties": {
        "cohortDigest": {
          "$ref": "#/$defs/Digest"
        },
        "total": {
          "$ref": "#/$defs/CostRecord"
        },
        "includesFailedAttempts": {
          "type": "boolean",
          "const": true
        },
        "attemptIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "byDenominator": {
          "type": "object",
          "properties": {
            "perVerifiedOutcome": {
              "$ref": "#/$defs/CostRecord"
            },
            "perAcceptedOutcome": {
              "$ref": "#/$defs/CostRecord"
            },
            "perReleasedOutcome": {
              "$ref": "#/$defs/CostRecord"
            }
          },
          "additionalProperties": false
        },
        "formulaVersion": {
          "type": "string"
        }
      },
      "required": [
        "cohortDigest",
        "total",
        "includesFailedAttempts",
        "attemptIds",
        "formulaVersion"
      ],
      "additionalProperties": false
    },
    "attribution": {
      "type": "object",
      "properties": {
        "factoryVersionId": {
          "$ref": "#/$defs/Id"
        },
        "factoryVersionDigest": {
          "$ref": "#/$defs/Digest"
        },
        "executionProfileId": {
          "$ref": "#/$defs/Id"
        },
        "modelRouteDigests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Digest"
          }
        },
        "environment": {
          "type": "string"
        }
      },
      "required": [
        "factoryVersionId",
        "factoryVersionDigest",
        "environment"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "string",
      "enum": [
        "HELD",
        "REGRESSED",
        "ROLLED_BACK",
        "INCONCLUSIVE"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "OBSERVING",
        "CLOSED",
        "INVALIDATED"
      ]
    },
    "learningSignalIds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Id"
      }
    },
    "closedAt": {
      "$ref": "#/$defs/Timestamp"
    },
    "closedBy": {
      "$ref": "#/$defs/Actor"
    },
    "digest": {
      "$ref": "#/$defs/Digest",
      "description": "Digest over (releaseDigest, measurementContract.digest, measurements, cost, attribution, result). Computed at CLOSED."
    },
    "createdAt": {
      "$ref": "#/$defs/Timestamp"
    },
    "createdBy": {
      "$ref": "#/$defs/Actor"
    },
    "history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Transition"
      }
    }
  },
  "required": [
    "schemaVersion",
    "type",
    "id",
    "namespace",
    "releaseId",
    "releaseDigest",
    "intentId",
    "workOrderIds",
    "observationWindow",
    "measurementContract",
    "measurements",
    "operational",
    "cost",
    "attribution",
    "state",
    "createdAt",
    "createdBy"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "CLOSED"
          }
        }
      },
      "then": {
        "required": [
          "result",
          "closedAt",
          "closedBy",
          "digest"
        ],
        "properties": {
          "observationWindow": {
            "properties": {
              "status": {
                "const": "CLOSED"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operational": {
            "properties": {
              "rolledBack": {
                "const": true
              }
            }
          },
          "state": {
            "const": "CLOSED"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "const": "ROLLED_BACK"
          }
        }
      }
    }
  ],
  "$defs": {
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$",
      "description": "Instance identifier. Unique within the issuing namespace; combined with `namespace` it is globally unique."
    },
    "ArtifactUri": {
      "type": "string",
      "pattern": "^fdlc://v1/(intent|specification|plan|work-order|factory-manifest|factory-version|execution-profile|capability-manifest|qualification-record|context-package|attempt|candidate|evidence|verification|decision|release|outcome|learning-signal|improvement-candidate)(/[A-Za-z0-9][A-Za-z0-9._:@-]*)?$",
      "description": "Artifact type URI (`fdlc://v1/<artifact>`), optionally suffixed with an instance id."
    },
    "Namespace": {
      "type": "string",
      "format": "uri",
      "description": "URI of the issuing control plane or organization. Scopes every `id` in this record."
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "SHA-256 over the RFC 8785 (JCS) canonical JSON of the digested projection."
    },
    "GitSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$|^[a-f0-9]{64}$",
      "description": "Lowercase full Git object id (SHA-1 or SHA-256 repository)."
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 timestamp in UTC."
    },
    "Semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "RiskClass": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "AutonomyLevel": {
      "type": "string",
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3",
        "L4",
        "L5"
      ],
      "description": "HITL spectrum position. Effective autonomy is min(factory, objective, work order, policy, trust)."
    },
    "Actor": {
      "type": "object",
      "description": "Attributable identity. `identitySource` says how the control plane established it; never inferred from a client label.",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "human",
            "policy",
            "service",
            "agent",
            "system"
          ]
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "identitySource": {
          "type": "string",
          "enum": [
            "authenticated",
            "workload-identity",
            "service-command",
            "development-fallback"
          ]
        },
        "displayName": {
          "type": "string"
        },
        "delegationRef": {
          "$ref": "#/$defs/Id",
          "description": "Reference to the delegation record that grants this actor its authority."
        }
      },
      "required": [
        "kind",
        "id",
        "identitySource"
      ],
      "additionalProperties": false
    },
    "Ref": {
      "type": "object",
      "description": "Reference to another FDLC artifact instance, optionally pinned to a digest.",
      "properties": {
        "type": {
          "$ref": "#/$defs/ArtifactUri"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "revisionNumber": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false
    },
    "Money": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "additionalProperties": false
    },
    "CostRecord": {
      "type": "object",
      "description": "Cost with an honesty class. UNKNOWN cost stays UNKNOWN; implementations MUST NOT invent zeroes.",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "MEASURED",
            "ESTIMATED",
            "UNKNOWN"
          ]
        },
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Fraction of contributing cost items that were measured."
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    "Transition": {
      "type": "object",
      "description": "Audit record of one authoritative state transition. Every field listed here MUST be recorded.",
      "properties": {
        "transitionId": {
          "$ref": "#/$defs/Id"
        },
        "subjectId": {
          "$ref": "#/$defs/Id"
        },
        "priorVersion": {
          "type": "integer",
          "minimum": 0
        },
        "fromState": {
          "type": "string"
        },
        "toState": {
          "type": "string"
        },
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "reason": {
          "type": "string"
        },
        "policyVersion": {
          "type": "string"
        },
        "idempotencyKey": {
          "type": "string"
        },
        "occurredAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "requiredEvidenceIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "decisionId": {
          "$ref": "#/$defs/Id"
        },
        "invalidatedDependents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Ref"
          }
        }
      },
      "required": [
        "subjectId",
        "fromState",
        "toState",
        "actor",
        "reason",
        "idempotencyKey",
        "occurredAt"
      ],
      "additionalProperties": false
    },
    "ArtifactRef": {
      "type": "object",
      "description": "Content-addressed reference to a stored artifact (diff, log, screenshot, bundle).",
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "type": "string"
        },
        "mediaType": {
          "type": "string"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "storageRef": {
          "type": "string"
        }
      },
      "required": [
        "artifactId",
        "digest"
      ],
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^x-[a-z0-9]+(-[a-z0-9]+)*$": {}
  },
  "additionalProperties": false
}
