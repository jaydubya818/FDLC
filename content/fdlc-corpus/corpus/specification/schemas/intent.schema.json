{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fdlc.ai/schemas/v1/intent.schema.json",
  "title": "FDLC Intent",
  "description": "The requested outcome: goal, constraints, owner, risk, stop condition, budget. An Intent admitted for planning is the Objective of its Plan.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "type": {
      "type": "string",
      "const": "fdlc://v1/intent"
    },
    "id": {
      "$ref": "#/$defs/Id"
    },
    "namespace": {
      "$ref": "#/$defs/Namespace"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "description": "The outcome that matters, stated as a result, not an activity."
    },
    "rationale": {
      "type": "string",
      "description": "Business reason. Why this outcome, why now."
    },
    "owner": {
      "$ref": "#/$defs/Actor",
      "description": "Accountable Builder. MUST be a human actor."
    },
    "requester": {
      "$ref": "#/$defs/Actor"
    },
    "signalRefs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "description": "Observable events that preceded this Intent (issue, incident, telemetry, finding)."
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sourcesOfTruth": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SourceRef"
      }
    },
    "scope": {
      "type": "object",
      "properties": {
        "repositories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RepositoryScope"
          }
        },
        "environments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nonGoals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "riskClass": {
      "$ref": "#/$defs/RiskClass",
      "description": "Server-owned minimum classification. A client may raise it; only policy may lower it."
    },
    "riskReasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stopCondition": {
      "type": "string",
      "minLength": 1,
      "description": "The condition under which the factory MUST stop pursuing this Intent."
    },
    "budget": {
      "type": "object",
      "properties": {
        "costLimit": {
          "$ref": "#/$defs/Money"
        },
        "spent": {
          "$ref": "#/$defs/CostRecord"
        },
        "maxCorrectiveIterations": {
          "type": "integer",
          "minimum": 0
        },
        "maxReadOnlyConcurrency": {
          "type": "integer",
          "minimum": 1
        },
        "deadline": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "additionalProperties": false
    },
    "executionPolicy": {
      "type": "string",
      "enum": [
        "SERIAL_MUTATIONS",
        "EXPLICIT_PARALLEL"
      ],
      "description": "SERIAL_MUTATIONS: at most one repository-mutating Work Order active at a time."
    },
    "correctiveIterations": {
      "type": "integer",
      "minimum": 0
    },
    "state": {
      "type": "string",
      "enum": [
        "DRAFT",
        "ADMITTED",
        "PLANNING",
        "AWAITING_PLAN_APPROVAL",
        "READY",
        "IN_PROGRESS",
        "BLOCKED",
        "AWAITING_VERIFICATION",
        "AWAITING_ACCEPTANCE",
        "DONE",
        "CANCELED",
        "SUPERSEDED"
      ]
    },
    "admissionDecisionId": {
      "$ref": "#/$defs/Id",
      "description": "Decision (kind: admission) that made this Intent an Objective."
    },
    "currentSpecificationId": {
      "$ref": "#/$defs/Id"
    },
    "currentSpecificationDigest": {
      "$ref": "#/$defs/Digest"
    },
    "currentPlanId": {
      "$ref": "#/$defs/Id"
    },
    "currentPlanDigest": {
      "$ref": "#/$defs/Digest"
    },
    "activeWorkOrderId": {
      "$ref": "#/$defs/Id"
    },
    "workOrderIds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Id"
      }
    },
    "acceptanceDecisionId": {
      "$ref": "#/$defs/Id"
    },
    "blockingReason": {
      "type": "string"
    },
    "requiredHumanAction": {
      "type": "string"
    },
    "supersededById": {
      "$ref": "#/$defs/Id"
    },
    "admittedDigest": {
      "$ref": "#/$defs/Digest",
      "description": "Digest of the admitted projection (title, goal, rationale, constraints, scope, riskClass, stopCondition, budget.costLimit, owner.id). Frozen at ADMITTED."
    },
    "createdAt": {
      "$ref": "#/$defs/Timestamp"
    },
    "createdBy": {
      "$ref": "#/$defs/Actor"
    },
    "updatedAt": {
      "$ref": "#/$defs/Timestamp"
    },
    "admittedAt": {
      "$ref": "#/$defs/Timestamp"
    },
    "acceptedAt": {
      "$ref": "#/$defs/Timestamp"
    },
    "idempotencyKey": {
      "type": "string"
    },
    "history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Transition"
      }
    }
  },
  "required": [
    "schemaVersion",
    "type",
    "id",
    "namespace",
    "title",
    "goal",
    "owner",
    "riskClass",
    "stopCondition",
    "executionPolicy",
    "state",
    "createdAt",
    "createdBy",
    "updatedAt"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "ADMITTED",
              "PLANNING",
              "AWAITING_PLAN_APPROVAL",
              "READY",
              "IN_PROGRESS",
              "BLOCKED",
              "AWAITING_VERIFICATION",
              "AWAITING_ACCEPTANCE",
              "DONE"
            ]
          }
        }
      },
      "then": {
        "required": [
          "admissionDecisionId",
          "admittedDigest",
          "admittedAt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "DONE"
          }
        }
      },
      "then": {
        "required": [
          "acceptanceDecisionId",
          "acceptedAt"
        ]
      }
    },
    {
      "properties": {
        "owner": {
          "properties": {
            "kind": {
              "const": "human"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$",
      "description": "Instance identifier. Unique within the issuing namespace; combined with `namespace` it is globally unique."
    },
    "ArtifactUri": {
      "type": "string",
      "pattern": "^fdlc://v1/(intent|specification|plan|work-order|factory-manifest|factory-version|execution-profile|capability-manifest|qualification-record|context-package|attempt|candidate|evidence|verification|decision|release|outcome|learning-signal|improvement-candidate)(/[A-Za-z0-9][A-Za-z0-9._:@-]*)?$",
      "description": "Artifact type URI (`fdlc://v1/<artifact>`), optionally suffixed with an instance id."
    },
    "Namespace": {
      "type": "string",
      "format": "uri",
      "description": "URI of the issuing control plane or organization. Scopes every `id` in this record."
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "SHA-256 over the RFC 8785 (JCS) canonical JSON of the digested projection."
    },
    "GitSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$|^[a-f0-9]{64}$",
      "description": "Lowercase full Git object id (SHA-1 or SHA-256 repository)."
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 timestamp in UTC."
    },
    "Semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "RiskClass": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "AutonomyLevel": {
      "type": "string",
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3",
        "L4",
        "L5"
      ],
      "description": "HITL spectrum position. Effective autonomy is min(factory, objective, work order, policy, trust)."
    },
    "Actor": {
      "type": "object",
      "description": "Attributable identity. `identitySource` says how the control plane established it; never inferred from a client label.",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "human",
            "policy",
            "service",
            "agent",
            "system"
          ]
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "identitySource": {
          "type": "string",
          "enum": [
            "authenticated",
            "workload-identity",
            "service-command",
            "development-fallback"
          ]
        },
        "displayName": {
          "type": "string"
        },
        "delegationRef": {
          "$ref": "#/$defs/Id",
          "description": "Reference to the delegation record that grants this actor its authority."
        }
      },
      "required": [
        "kind",
        "id",
        "identitySource"
      ],
      "additionalProperties": false
    },
    "Ref": {
      "type": "object",
      "description": "Reference to another FDLC artifact instance, optionally pinned to a digest.",
      "properties": {
        "type": {
          "$ref": "#/$defs/ArtifactUri"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "revisionNumber": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false
    },
    "Money": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "additionalProperties": false
    },
    "CostRecord": {
      "type": "object",
      "description": "Cost with an honesty class. UNKNOWN cost stays UNKNOWN; implementations MUST NOT invent zeroes.",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "MEASURED",
            "ESTIMATED",
            "UNKNOWN"
          ]
        },
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Fraction of contributing cost items that were measured."
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    "Transition": {
      "type": "object",
      "description": "Audit record of one authoritative state transition. Every field listed here MUST be recorded.",
      "properties": {
        "transitionId": {
          "$ref": "#/$defs/Id"
        },
        "subjectId": {
          "$ref": "#/$defs/Id"
        },
        "priorVersion": {
          "type": "integer",
          "minimum": 0
        },
        "fromState": {
          "type": "string"
        },
        "toState": {
          "type": "string"
        },
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "reason": {
          "type": "string"
        },
        "policyVersion": {
          "type": "string"
        },
        "idempotencyKey": {
          "type": "string"
        },
        "occurredAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "requiredEvidenceIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "decisionId": {
          "$ref": "#/$defs/Id"
        },
        "invalidatedDependents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Ref"
          }
        }
      },
      "required": [
        "subjectId",
        "fromState",
        "toState",
        "actor",
        "reason",
        "idempotencyKey",
        "occurredAt"
      ],
      "additionalProperties": false
    },
    "ArtifactRef": {
      "type": "object",
      "description": "Content-addressed reference to a stored artifact (diff, log, screenshot, bundle).",
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "type": "string"
        },
        "mediaType": {
          "type": "string"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "storageRef": {
          "type": "string"
        }
      },
      "required": [
        "artifactId",
        "digest"
      ],
      "additionalProperties": false
    },
    "SourceRef": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "repo",
            "doc",
            "prd",
            "issue",
            "url",
            "incident",
            "telemetry",
            "finding"
          ]
        },
        "label": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "kind",
        "label",
        "location"
      ],
      "additionalProperties": false
    },
    "RepositoryScope": {
      "type": "object",
      "properties": {
        "repositoryId": {
          "$ref": "#/$defs/Id"
        },
        "provider": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "defaultBranch": {
          "type": "string"
        },
        "codeScopes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Governed path allowlist identifiers; frozen into the execution manifest."
        },
        "dataClassification": {
          "type": "string",
          "enum": [
            "PUBLIC",
            "INTERNAL",
            "CONFIDENTIAL",
            "RESTRICTED"
          ]
        }
      },
      "required": [
        "repositoryId",
        "name"
      ],
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^x-[a-z0-9]+(-[a-z0-9]+)*$": {}
  },
  "additionalProperties": false
}
