{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fdlc.ai/schemas/v1/release.schema.json",
  "title": "FDLC Release",
  "description": "Promotion of an exact accepted artifact into an environment with current policy, rollout scope, and rollback readiness. Release promotes a software artifact; Deploy (Factory Lifecycle) promotes a Factory Version.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "type": {
      "type": "string",
      "const": "fdlc://v1/release"
    },
    "id": {
      "$ref": "#/$defs/Id"
    },
    "namespace": {
      "$ref": "#/$defs/Namespace"
    },
    "intentId": {
      "$ref": "#/$defs/Id"
    },
    "workOrderIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Id"
      }
    },
    "candidateId": {
      "$ref": "#/$defs/Id"
    },
    "candidateDigest": {
      "$ref": "#/$defs/Digest"
    },
    "acceptanceDecisionId": {
      "$ref": "#/$defs/Id"
    },
    "releaseAuthorizationDecisionId": {
      "$ref": "#/$defs/Id"
    },
    "factoryVersionId": {
      "$ref": "#/$defs/Id"
    },
    "artifact": {
      "type": "object",
      "description": "The exact thing promoted. Every identity here is content-addressed.",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "MERGE_COMMIT",
            "CONTAINER_IMAGE",
            "PACKAGE",
            "BUNDLE",
            "CONFIGURATION"
          ]
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "mergeCommitSha": {
          "$ref": "#/$defs/GitSha"
        },
        "sourceHeadSha": {
          "$ref": "#/$defs/GitSha"
        },
        "buildDigest": {
          "$ref": "#/$defs/Digest"
        },
        "packageRef": {
          "type": "string"
        },
        "sbomRef": {
          "type": "string"
        },
        "provenanceRef": {
          "type": "string",
          "description": "SLSA provenance attestation for the build."
        },
        "mergedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "mergeActor": {
          "$ref": "#/$defs/Actor"
        },
        "pullRequest": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string"
            },
            "number": {
              "type": "integer"
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "provider",
            "number",
            "url"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "digest"
      ],
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string"
        },
        "tier": {
          "type": "string",
          "enum": [
            "REVIEW",
            "STAGING",
            "PRODUCTION"
          ]
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "id",
        "name",
        "tier"
      ],
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "policyBundleDigest": {
          "$ref": "#/$defs/Digest"
        },
        "currentAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "approvalPolicyDigest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "policyBundleDigest",
        "currentAt"
      ],
      "additionalProperties": false
    },
    "rollout": {
      "type": "object",
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "CANARY",
            "PERCENTAGE",
            "REGION",
            "FULL"
          ]
        },
        "cohort": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "step": {
                "type": "integer",
                "minimum": 1
              },
              "exposure": {
                "type": "string"
              },
              "gate": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "PENDING",
                  "PASSED",
                  "FAILED",
                  "SKIPPED"
                ]
              },
              "decisionId": {
                "$ref": "#/$defs/Id"
              },
              "evidenceIds": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Id"
                }
              }
            },
            "required": [
              "step",
              "exposure",
              "gate",
              "status"
            ],
            "additionalProperties": false
          }
        },
        "provider": {
          "type": "string"
        },
        "providerDeploymentRef": {
          "type": "string"
        },
        "deploymentUrl": {
          "type": "string"
        }
      },
      "required": [
        "strategy",
        "steps"
      ],
      "additionalProperties": false
    },
    "rollback": {
      "type": "object",
      "properties": {
        "ready": {
          "type": "boolean"
        },
        "strategy": {
          "type": "string",
          "enum": [
            "ROLLBACK",
            "ROLL_FORWARD",
            "CONTAINMENT",
            "HUMAN_DIRECTED"
          ]
        },
        "target": {
          "type": "object",
          "properties": {
            "commitSha": {
              "$ref": "#/$defs/GitSha"
            },
            "artifactDigest": {
              "$ref": "#/$defs/Digest"
            },
            "releaseId": {
              "$ref": "#/$defs/Id"
            }
          },
          "additionalProperties": false
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "planDigest": {
          "$ref": "#/$defs/Digest"
        },
        "owner": {
          "$ref": "#/$defs/Actor"
        },
        "executedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "restoredCommitSha": {
          "$ref": "#/$defs/GitSha"
        },
        "providerRef": {
          "type": "string"
        }
      },
      "required": [
        "ready",
        "strategy",
        "conditions",
        "planDigest",
        "owner"
      ],
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "description": "Release-level verification: environment validation, canary/production verification. Evidence ids, not claims.",
      "properties": {
        "environmentValidationEvidenceIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "smokeEvidenceIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "healthEvidenceIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "canaryComparisonEvidenceIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "productionVerificationEvidenceIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "verificationId": {
          "$ref": "#/$defs/Id"
        },
        "verificationAttemptCount": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "verificationAttemptCount"
      ],
      "additionalProperties": false
    },
    "observationWindow": {
      "type": "object",
      "properties": {
        "start": {
          "$ref": "#/$defs/Timestamp"
        },
        "end": {
          "$ref": "#/$defs/Timestamp"
        },
        "outcomeId": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "state": {
      "type": "string",
      "enum": [
        "ELIGIBLE",
        "AUTHORIZED",
        "DEPLOYED",
        "VERIFIED",
        "PROMOTED",
        "ROLLED_BACK",
        "FAILED"
      ]
    },
    "blockingIssue": {
      "type": "string"
    },
    "requiredHumanAction": {
      "type": "string"
    },
    "authorizedAt": {
      "$ref": "#/$defs/Timestamp"
    },
    "deployedAt": {
      "$ref": "#/$defs/Timestamp"
    },
    "verifiedAt": {
      "$ref": "#/$defs/Timestamp"
    },
    "promotedAt": {
      "$ref": "#/$defs/Timestamp"
    },
    "rolledBackAt": {
      "$ref": "#/$defs/Timestamp"
    },
    "digest": {
      "$ref": "#/$defs/Digest",
      "description": "Digest over (candidateDigest, artifact.digest, environment.id, policy.policyBundleDigest, rollout.strategy, rollback.planDigest)."
    },
    "createdAt": {
      "$ref": "#/$defs/Timestamp"
    },
    "createdBy": {
      "$ref": "#/$defs/Actor"
    },
    "history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Transition"
      }
    }
  },
  "required": [
    "schemaVersion",
    "type",
    "id",
    "namespace",
    "intentId",
    "workOrderIds",
    "candidateId",
    "candidateDigest",
    "acceptanceDecisionId",
    "artifact",
    "environment",
    "policy",
    "rollout",
    "rollback",
    "verification",
    "state",
    "digest",
    "createdAt",
    "createdBy"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "AUTHORIZED",
              "DEPLOYED",
              "VERIFIED",
              "PROMOTED",
              "ROLLED_BACK"
            ]
          }
        }
      },
      "then": {
        "required": [
          "releaseAuthorizationDecisionId",
          "authorizedAt"
        ],
        "properties": {
          "rollback": {
            "properties": {
              "ready": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "DEPLOYED",
              "VERIFIED",
              "PROMOTED"
            ]
          }
        }
      },
      "then": {
        "required": [
          "deployedAt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "VERIFIED",
              "PROMOTED"
            ]
          }
        }
      },
      "then": {
        "required": [
          "verifiedAt"
        ],
        "properties": {
          "verification": {
            "required": [
              "healthEvidenceIds",
              "environmentValidationEvidenceIds"
            ],
            "properties": {
              "healthEvidenceIds": {
                "minItems": 1
              },
              "environmentValidationEvidenceIds": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "PROMOTED"
          }
        }
      },
      "then": {
        "required": [
          "promotedAt",
          "observationWindow"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "ROLLED_BACK"
          }
        }
      },
      "then": {
        "required": [
          "rolledBackAt"
        ],
        "properties": {
          "rollback": {
            "required": [
              "executedAt"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "environment": {
            "properties": {
              "tier": {
                "const": "PRODUCTION"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "verification": {
            "required": [
              "canaryComparisonEvidenceIds"
            ]
          },
          "rollout": {
            "properties": {
              "strategy": {
                "enum": [
                  "CANARY",
                  "PERCENTAGE",
                  "REGION"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$",
      "description": "Instance identifier. Unique within the issuing namespace; combined with `namespace` it is globally unique."
    },
    "ArtifactUri": {
      "type": "string",
      "pattern": "^fdlc://v1/(intent|specification|plan|work-order|factory-manifest|factory-version|execution-profile|capability-manifest|qualification-record|context-package|attempt|candidate|evidence|verification|decision|release|outcome|learning-signal|improvement-candidate)(/[A-Za-z0-9][A-Za-z0-9._:@-]*)?$",
      "description": "Artifact type URI (`fdlc://v1/<artifact>`), optionally suffixed with an instance id."
    },
    "Namespace": {
      "type": "string",
      "format": "uri",
      "description": "URI of the issuing control plane or organization. Scopes every `id` in this record."
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "SHA-256 over the RFC 8785 (JCS) canonical JSON of the digested projection."
    },
    "GitSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$|^[a-f0-9]{64}$",
      "description": "Lowercase full Git object id (SHA-1 or SHA-256 repository)."
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 timestamp in UTC."
    },
    "Semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "RiskClass": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "AutonomyLevel": {
      "type": "string",
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3",
        "L4",
        "L5"
      ],
      "description": "HITL spectrum position. Effective autonomy is min(factory, objective, work order, policy, trust)."
    },
    "Actor": {
      "type": "object",
      "description": "Attributable identity. `identitySource` says how the control plane established it; never inferred from a client label.",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "human",
            "policy",
            "service",
            "agent",
            "system"
          ]
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "identitySource": {
          "type": "string",
          "enum": [
            "authenticated",
            "workload-identity",
            "service-command",
            "development-fallback"
          ]
        },
        "displayName": {
          "type": "string"
        },
        "delegationRef": {
          "$ref": "#/$defs/Id",
          "description": "Reference to the delegation record that grants this actor its authority."
        }
      },
      "required": [
        "kind",
        "id",
        "identitySource"
      ],
      "additionalProperties": false
    },
    "Ref": {
      "type": "object",
      "description": "Reference to another FDLC artifact instance, optionally pinned to a digest.",
      "properties": {
        "type": {
          "$ref": "#/$defs/ArtifactUri"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "revisionNumber": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false
    },
    "Money": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "additionalProperties": false
    },
    "CostRecord": {
      "type": "object",
      "description": "Cost with an honesty class. UNKNOWN cost stays UNKNOWN; implementations MUST NOT invent zeroes.",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "MEASURED",
            "ESTIMATED",
            "UNKNOWN"
          ]
        },
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Fraction of contributing cost items that were measured."
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    "Transition": {
      "type": "object",
      "description": "Audit record of one authoritative state transition. Every field listed here MUST be recorded.",
      "properties": {
        "transitionId": {
          "$ref": "#/$defs/Id"
        },
        "subjectId": {
          "$ref": "#/$defs/Id"
        },
        "priorVersion": {
          "type": "integer",
          "minimum": 0
        },
        "fromState": {
          "type": "string"
        },
        "toState": {
          "type": "string"
        },
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "reason": {
          "type": "string"
        },
        "policyVersion": {
          "type": "string"
        },
        "idempotencyKey": {
          "type": "string"
        },
        "occurredAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "requiredEvidenceIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "decisionId": {
          "$ref": "#/$defs/Id"
        },
        "invalidatedDependents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Ref"
          }
        }
      },
      "required": [
        "subjectId",
        "fromState",
        "toState",
        "actor",
        "reason",
        "idempotencyKey",
        "occurredAt"
      ],
      "additionalProperties": false
    },
    "ArtifactRef": {
      "type": "object",
      "description": "Content-addressed reference to a stored artifact (diff, log, screenshot, bundle).",
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "type": "string"
        },
        "mediaType": {
          "type": "string"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "storageRef": {
          "type": "string"
        }
      },
      "required": [
        "artifactId",
        "digest"
      ],
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^x-[a-z0-9]+(-[a-z0-9]+)*$": {}
  },
  "additionalProperties": false
}
