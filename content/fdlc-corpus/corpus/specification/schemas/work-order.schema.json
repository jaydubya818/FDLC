{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fdlc.ai/schemas/v1/work-order.schema.json",
  "title": "FDLC Work Order",
  "description": "The bounded, authorized unit of work: scope, risk class, authority envelope, verification contract, change budget, negative constraints, bound Factory Version + Execution Profile. Contains Tasks.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "type": {
      "type": "string",
      "const": "fdlc://v1/work-order"
    },
    "id": {
      "$ref": "#/$defs/Id"
    },
    "namespace": {
      "$ref": "#/$defs/Namespace"
    },
    "intentId": {
      "$ref": "#/$defs/Id"
    },
    "planId": {
      "$ref": "#/$defs/Id"
    },
    "planDigest": {
      "$ref": "#/$defs/Digest"
    },
    "blueprintId": {
      "$ref": "#/$defs/Id"
    },
    "qualityContractDigest": {
      "$ref": "#/$defs/Digest"
    },
    "specificationDigest": {
      "$ref": "#/$defs/Digest"
    },
    "revisionNumber": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "SOFTWARE_CHANGE",
        "VERIFICATION",
        "AUTOMATION"
      ]
    },
    "role": {
      "type": "string",
      "enum": [
        "PRODUCER",
        "VERIFIER"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "desiredOutcome": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "string"
    },
    "isMutating": {
      "type": "boolean"
    },
    "repository": {
      "type": "object",
      "properties": {
        "repositoryId": {
          "$ref": "#/$defs/Id"
        },
        "provider": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "baseRef": {
          "type": "string"
        },
        "branchStrategy": {
          "type": "string"
        },
        "dataClassification": {
          "type": "string",
          "enum": [
            "PUBLIC",
            "INTERNAL",
            "CONFIDENTIAL",
            "RESTRICTED"
          ]
        },
        "codeScopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CodeScope"
          }
        }
      },
      "required": [
        "repositoryId",
        "name",
        "baseRef",
        "codeScopes"
      ],
      "additionalProperties": false
    },
    "riskClass": {
      "$ref": "#/$defs/RiskClass"
    },
    "riskReasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "autonomyLevel": {
      "$ref": "#/$defs/AutonomyLevel"
    },
    "authorityEnvelope": {
      "$ref": "#/$defs/AuthorityEnvelope"
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Requirement"
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/AcceptanceCriterion"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "negativeConstraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NegativeConstraint"
      }
    },
    "dataBoundaries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DataBoundary"
      }
    },
    "changeBudget": {
      "$ref": "#/$defs/ChangeBudget"
    },
    "verificationContract": {
      "$ref": "#/$defs/VerificationContract"
    },
    "verificationContractDigest": {
      "$ref": "#/$defs/Digest"
    },
    "budgets": {
      "type": "object",
      "properties": {
        "maxCost": {
          "$ref": "#/$defs/Money"
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 1
        },
        "maxRuntimeMinutes": {
          "type": "integer",
          "minimum": 1
        },
        "stopCondition": {
          "type": "string"
        },
        "spendingFence": {
          "type": "object",
          "properties": {
            "fencedAt": {
              "$ref": "#/$defs/Timestamp"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "fencedAt",
            "reason"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "maxCost",
        "maxAttempts",
        "maxRuntimeMinutes",
        "stopCondition"
      ],
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "description": "Result of Route (Delivery Loop step 4). Frozen once ROUTED; a change requires a new routing Decision.",
      "properties": {
        "routingDecisionId": {
          "$ref": "#/$defs/Id"
        },
        "factoryManifestId": {
          "$ref": "#/$defs/Id"
        },
        "factoryVersionId": {
          "$ref": "#/$defs/Id"
        },
        "factoryVersionDigest": {
          "$ref": "#/$defs/Digest"
        },
        "executionProfileId": {
          "$ref": "#/$defs/Id"
        },
        "executionProfileDigest": {
          "$ref": "#/$defs/Digest"
        },
        "verifierFactoryVersionId": {
          "$ref": "#/$defs/Id"
        },
        "pinned": {
          "type": "boolean"
        },
        "boundAt": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "routingDecisionId",
        "factoryVersionId",
        "factoryVersionDigest",
        "executionProfileId",
        "executionProfileDigest",
        "boundAt"
      ],
      "additionalProperties": false
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Task"
      }
    },
    "dependsOnWorkOrderIds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Id"
      }
    },
    "state": {
      "type": "string",
      "enum": [
        "DRAFT",
        "READY",
        "ROUTED",
        "DISPATCHED",
        "IN_PROGRESS",
        "BLOCKED",
        "AWAITING_APPROVAL",
        "AWAITING_VERIFICATION",
        "REOPENED",
        "DONE",
        "CANCELED",
        "SUPERSEDED"
      ]
    },
    "verificationStatus": {
      "type": "string",
      "enum": [
        "PENDING",
        "PASS",
        "FAIL",
        "WAIVED",
        "STALE"
      ]
    },
    "approvalStatus": {
      "type": "string",
      "enum": [
        "NOT_REQUIRED",
        "PENDING",
        "APPROVED",
        "CONDITIONAL",
        "REJECTED",
        "REVISION_REQUESTED",
        "EXPIRED",
        "REVOKED"
      ]
    },
    "currentAttemptId": {
      "$ref": "#/$defs/Id"
    },
    "attemptIds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Id"
      }
    },
    "currentCandidateId": {
      "$ref": "#/$defs/Id"
    },
    "currentVerificationId": {
      "$ref": "#/$defs/Id"
    },
    "acceptanceDecisionId": {
      "$ref": "#/$defs/Id"
    },
    "acceptedRevisionNumber": {
      "type": "integer",
      "minimum": 1
    },
    "revisionMateriality": {
      "type": "string",
      "enum": [
        "NO_ACTION",
        "REVERIFICATION",
        "REAPPROVAL",
        "BOTH",
        "FULL_REOPEN"
      ]
    },
    "supersededById": {
      "$ref": "#/$defs/Id"
    },
    "supersedesId": {
      "$ref": "#/$defs/Id"
    },
    "blockingIssue": {
      "type": "string"
    },
    "requiredHumanAction": {
      "type": "string"
    },
    "digest": {
      "$ref": "#/$defs/Digest",
      "description": "Digest of the revision's contract projection (kind, desiredOutcome, repository, riskClass, autonomyLevel, authorityEnvelope, acceptanceCriteria, negativeConstraints, dataBoundaries, changeBudget, verificationContract, budgets)."
    },
    "createdAt": {
      "$ref": "#/$defs/Timestamp"
    },
    "createdBy": {
      "$ref": "#/$defs/Actor"
    },
    "updatedAt": {
      "$ref": "#/$defs/Timestamp"
    },
    "releasedAt": {
      "$ref": "#/$defs/Timestamp"
    },
    "idempotencyKey": {
      "type": "string"
    },
    "history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Transition"
      }
    }
  },
  "required": [
    "schemaVersion",
    "type",
    "id",
    "namespace",
    "intentId",
    "planId",
    "planDigest",
    "blueprintId",
    "qualityContractDigest",
    "revisionNumber",
    "kind",
    "role",
    "title",
    "desiredOutcome",
    "isMutating",
    "repository",
    "riskClass",
    "autonomyLevel",
    "authorityEnvelope",
    "acceptanceCriteria",
    "negativeConstraints",
    "changeBudget",
    "verificationContract",
    "verificationContractDigest",
    "budgets",
    "state",
    "verificationStatus",
    "approvalStatus",
    "digest",
    "createdAt",
    "createdBy",
    "updatedAt"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "ROUTED",
              "DISPATCHED",
              "IN_PROGRESS",
              "AWAITING_APPROVAL",
              "AWAITING_VERIFICATION",
              "DONE"
            ]
          }
        }
      },
      "then": {
        "required": [
          "binding"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "DONE"
          }
        }
      },
      "then": {
        "required": [
          "acceptanceDecisionId",
          "acceptedRevisionNumber",
          "currentCandidateId",
          "currentVerificationId"
        ],
        "properties": {
          "verificationStatus": {
            "enum": [
              "PASS",
              "WAIVED"
            ]
          },
          "approvalStatus": {
            "enum": [
              "NOT_REQUIRED",
              "APPROVED",
              "CONDITIONAL"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "riskClass": {
            "const": "CRITICAL"
          }
        }
      },
      "then": {
        "properties": {
          "autonomyLevel": {
            "enum": [
              "L0",
              "L1",
              "L2"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$",
      "description": "Instance identifier. Unique within the issuing namespace; combined with `namespace` it is globally unique."
    },
    "ArtifactUri": {
      "type": "string",
      "pattern": "^fdlc://v1/(intent|specification|plan|work-order|factory-manifest|factory-version|execution-profile|capability-manifest|qualification-record|context-package|attempt|candidate|evidence|verification|decision|release|outcome|learning-signal|improvement-candidate)(/[A-Za-z0-9][A-Za-z0-9._:@-]*)?$",
      "description": "Artifact type URI (`fdlc://v1/<artifact>`), optionally suffixed with an instance id."
    },
    "Namespace": {
      "type": "string",
      "format": "uri",
      "description": "URI of the issuing control plane or organization. Scopes every `id` in this record."
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "SHA-256 over the RFC 8785 (JCS) canonical JSON of the digested projection."
    },
    "GitSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$|^[a-f0-9]{64}$",
      "description": "Lowercase full Git object id (SHA-1 or SHA-256 repository)."
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 timestamp in UTC."
    },
    "Semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "RiskClass": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "AutonomyLevel": {
      "type": "string",
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3",
        "L4",
        "L5"
      ],
      "description": "HITL spectrum position. Effective autonomy is min(factory, objective, work order, policy, trust)."
    },
    "Actor": {
      "type": "object",
      "description": "Attributable identity. `identitySource` says how the control plane established it; never inferred from a client label.",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "human",
            "policy",
            "service",
            "agent",
            "system"
          ]
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "identitySource": {
          "type": "string",
          "enum": [
            "authenticated",
            "workload-identity",
            "service-command",
            "development-fallback"
          ]
        },
        "displayName": {
          "type": "string"
        },
        "delegationRef": {
          "$ref": "#/$defs/Id",
          "description": "Reference to the delegation record that grants this actor its authority."
        }
      },
      "required": [
        "kind",
        "id",
        "identitySource"
      ],
      "additionalProperties": false
    },
    "Ref": {
      "type": "object",
      "description": "Reference to another FDLC artifact instance, optionally pinned to a digest.",
      "properties": {
        "type": {
          "$ref": "#/$defs/ArtifactUri"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "revisionNumber": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false
    },
    "Money": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "additionalProperties": false
    },
    "CostRecord": {
      "type": "object",
      "description": "Cost with an honesty class. UNKNOWN cost stays UNKNOWN; implementations MUST NOT invent zeroes.",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "MEASURED",
            "ESTIMATED",
            "UNKNOWN"
          ]
        },
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Fraction of contributing cost items that were measured."
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    "Transition": {
      "type": "object",
      "description": "Audit record of one authoritative state transition. Every field listed here MUST be recorded.",
      "properties": {
        "transitionId": {
          "$ref": "#/$defs/Id"
        },
        "subjectId": {
          "$ref": "#/$defs/Id"
        },
        "priorVersion": {
          "type": "integer",
          "minimum": 0
        },
        "fromState": {
          "type": "string"
        },
        "toState": {
          "type": "string"
        },
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "reason": {
          "type": "string"
        },
        "policyVersion": {
          "type": "string"
        },
        "idempotencyKey": {
          "type": "string"
        },
        "occurredAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "requiredEvidenceIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "decisionId": {
          "$ref": "#/$defs/Id"
        },
        "invalidatedDependents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Ref"
          }
        }
      },
      "required": [
        "subjectId",
        "fromState",
        "toState",
        "actor",
        "reason",
        "idempotencyKey",
        "occurredAt"
      ],
      "additionalProperties": false
    },
    "ArtifactRef": {
      "type": "object",
      "description": "Content-addressed reference to a stored artifact (diff, log, screenshot, bundle).",
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "type": "string"
        },
        "mediaType": {
          "type": "string"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "storageRef": {
          "type": "string"
        }
      },
      "required": [
        "artifactId",
        "digest"
      ],
      "additionalProperties": false
    },
    "CodeScope": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "includePaths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "excludePaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "includePaths"
      ],
      "additionalProperties": false
    },
    "AuthorityEnvelope": {
      "type": "object",
      "description": "What this Work Order may cause to happen. Capability ≠ permission ≠ authority; this is the authority grant.",
      "properties": {
        "allowedActions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "READ_REPOSITORY",
              "MODIFY_WORKTREE",
              "RUN_TESTS",
              "RUN_BUILD",
              "INSTALL_DEPENDENCIES",
              "NETWORK_EGRESS_ALLOWLIST",
              "PROPOSE_CANDIDATE",
              "REQUEST_HUMAN_DECISION"
            ]
          }
        },
        "prohibitedActions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "PUBLISH_BRANCH",
              "OPEN_PULL_REQUEST",
              "MERGE",
              "DEPLOY",
              "APPROVE",
              "ACCEPT",
              "MODIFY_VERIFICATION_CONFIG",
              "ACCESS_PRODUCTION",
              "ACCESS_SECRETS",
              "WIDEN_SCOPE"
            ]
          }
        },
        "allowedCapabilityIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "credentialClasses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "networkPolicyDigest": {
          "$ref": "#/$defs/Digest"
        },
        "publicationAuthority": {
          "type": "string",
          "const": "CONTROL_PLANE_ONLY"
        },
        "requiredDecisions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "admission",
                  "acceptance",
                  "release-authorization",
                  "exception"
                ]
              },
              "actorKind": {
                "type": "string",
                "enum": [
                  "human",
                  "policy"
                ]
              },
              "role": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "actorKind"
            ],
            "additionalProperties": false
          }
        },
        "escalationConditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "allowedActions",
        "prohibitedActions",
        "publicationAuthority",
        "requiredDecisions"
      ],
      "additionalProperties": false
    },
    "Requirement": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "FUNCTIONAL",
            "NON_FUNCTIONAL"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "MUST",
            "SHOULD"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "type",
        "priority"
      ],
      "additionalProperties": false
    },
    "EvidenceRequirement": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string"
        },
        "minimumCount": {
          "type": "integer",
          "minimum": 1
        },
        "independenceLevel": {
          "type": "string",
          "enum": [
            "ANY_VERIFICATION",
            "CANDIDATE_DEPENDENT_ALLOWED",
            "INDEPENDENT_REQUIRED"
          ]
        }
      },
      "required": [
        "category",
        "minimumCount",
        "independenceLevel"
      ],
      "additionalProperties": false
    },
    "AcceptanceCriterion": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "assertionId": {
          "$ref": "#/$defs/Id"
        },
        "requirementIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "givenWhenThen": {
          "type": "object",
          "properties": {
            "given": {
              "type": "string"
            },
            "when": {
              "type": "string"
            },
            "then": {
              "type": "string"
            }
          },
          "required": [
            "given",
            "when",
            "then"
          ],
          "additionalProperties": false
        },
        "verificationMethod": {
          "type": "string",
          "enum": [
            "COMMAND",
            "TEST",
            "BROWSER",
            "MANUAL",
            "CHECKLIST",
            "ANALYSIS"
          ]
        },
        "requiredEvidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/EvidenceRequirement"
          }
        },
        "waiverAllowed": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "PENDING",
            "PASS",
            "FAIL",
            "WAIVED",
            "STALE"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "requiredEvidence",
