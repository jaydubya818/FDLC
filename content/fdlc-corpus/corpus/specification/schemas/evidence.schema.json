{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fdlc.ai/schemas/v1/evidence.schema.json",
  "title": "FDLC Evidence",
  "description": "Durable, attributable record of what was authorized, executed, observed, verified, or decided — bound to an exact subject with provenance, integrity, and validity conditions. Six states: MISSING, PENDING, CURRENT, STALE, CONFLICTING, SUPERSEDED. Exchangeable as the predicate of an in-toto Statement.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "type": {
      "type": "string",
      "const": "fdlc://v1/evidence"
    },
    "id": {
      "$ref": "#/$defs/Id"
    },
    "namespace": {
      "$ref": "#/$defs/Namespace"
    },
    "evidenceKey": {
      "type": "string",
      "description": "Stable key for the expected evidence slot (contract check × criterion). Lets a MISSING record exist before any observation."
    },
    "category": {
      "type": "string",
      "enum": [
        "TEST_RESULT",
        "BUILD_RESULT",
        "STATIC_ANALYSIS",
        "SECURITY_SCAN",
        "DEPENDENCY_SCAN",
        "COMMAND_LOG",
        "FILE_DIFF",
        "SCREENSHOT",
        "BROWSER_RESULT",
        "PERFORMANCE_RESULT",
        "REVIEW_RESULT",
        "POLICY_RESULT",
        "CI_RESULT",
        "RUNTIME_OBSERVATION",
        "EVALUATION_SCORE",
        "PROVENANCE",
        "TOOL_CALL_RECEIPT",
        "DEPLOYMENT_CHECK",
        "DECISION_RECORD",
        "MODEL_IDENTITY",
        "TRACE"
      ]
    },
    "checkId": {
      "$ref": "#/$defs/Id"
    },
    "criterionIds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Id"
      }
    },
    "requirementIds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Id"
      }
    },
    "riskIds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Id"
      }
    },
    "subject": {
      "$ref": "#/$defs/SubjectBinding"
    },
    "producer": {
      "$ref": "#/$defs/ProducerBinding"
    },
    "independence": {
      "type": "object",
      "properties": {
        "policyVersion": {
          "type": "string"
        },
        "passed": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sourceAttemptId": {
          "$ref": "#/$defs/Id"
        },
        "verificationAttemptId": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "policyVersion",
        "passed",
        "reasons"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "SKIPPED",
        "NOT_CONFIGURED",
        "ERROR",
        "WAIVED",
        "NOT_APPLICABLE",
        "UNKNOWN"
      ],
      "description": "What the verifier observed. Only PASS satisfies a mandatory check. WAIVED stays WAIVED; it never renders as PASS."
    },
    "summary": {
      "type": "string"
    },
    "measurements": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "number",
          "string",
          "boolean",
          "null"
        ]
      }
    },
    "tool": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exitCode": {
          "type": [
            "integer",
            "null"
          ]
        },
        "durationMs": {
          "type": [
            "integer",
            "null"
          ]
        },
        "environmentDigest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      }
    },
    "integrity": {
      "type": "object",
      "properties": {
        "contentDigest": {
          "$ref": "#/$defs/Digest",
          "description": "Digest of the canonical evidence payload (everything except integrity, validity.state-derived fields, and history)."
        },
        "signature": {
          "type": "object",
          "properties": {
            "format": {
              "type": "string",
              "enum": [
                "dsse",
                "jws",
                "none"
              ]
            },
            "keyId": {
              "type": "string"
            },
            "signatureRef": {
              "type": "string"
            },
            "signer": {
              "type": "string"
            },
            "transparencyLogRef": {
              "type": "string"
            }
          },
          "required": [
            "format"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "contentDigest",
        "signature"
      ],
      "additionalProperties": false
    },
    "validity": {
      "type": "object",
      "description": "Currentness conditions. The state is derived from these fields and the subject's current head; it is never set by the producer.",
      "properties": {
        "observedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "validUntil": {
          "$ref": "#/$defs/Timestamp"
        },
        "invalidatedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "invalidatedBy": {
          "$ref": "#/$defs/Ref"
        },
        "invalidationReason": {
          "type": "string"
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "SUBJECT_HEAD",
              "WORK_ORDER_REVISION",
              "VERIFICATION_CONTRACT",
              "PLAN_DIGEST",
              "ENVIRONMENT_DIGEST",
              "TOOL_VERSION",
              "POLICY_VERSION",
              "DEPENDENCY_GRAPH",
              "VALIDITY_WINDOW"
            ]
          }
        },
        "staleReasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "observedAt",
        "assumptions"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "LIVE",
            "SYNTHETIC",
            "DEMO",
            "IMPORTED",
            "LEGACY"
          ],
          "description": "Only LIVE evidence counts toward acceptance."
        },
        "traceRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "traceId": {
                "type": "string"
              },
              "spanId": {
                "type": "string"
              }
            },
            "required": [
              "traceId"
            ],
            "additionalProperties": false
          }
        },
        "executionManifestDigest": {
          "$ref": "#/$defs/Digest"
        },
        "executionProfileDigest": {
          "$ref": "#/$defs/Digest"
        },
        "receiptPacketDigest": {
          "$ref": "#/$defs/Digest",
          "description": "Digest of the runtime receipt packet this envelope was validated from."
        }
      },
      "required": [
        "class"
      ],
      "additionalProperties": false
    },
    "attestation": {
      "type": "object",
      "description": "in-toto Statement wrapper for exchange. The predicate is this Evidence record (without `attestation` and `history`).",
      "properties": {
        "statementType": {
          "type": "string",
          "const": "https://in-toto.io/Statement/v1"
        },
        "predicateType": {
          "type": "string",
          "const": "https://fdlc.ai/attestation/evidence/v1"
        },
        "subjects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "digest": {
                "type": "object",
                "properties": {
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "gitCommit": {
                    "$ref": "#/$defs/GitSha"
                  },
                  "gitTree": {
                    "$ref": "#/$defs/GitSha"
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "name",
              "digest"
            ],
            "additionalProperties": false
          }
        },
        "statementDigest": {
          "$ref": "#/$defs/Digest"
        },
        "envelopeRef": {
          "type": "string",
          "description": "Locator of the DSSE envelope."
        },
        "envelopeFormat": {
          "type": "string",
          "enum": [
            "dsse",
            "none"
          ]
        }
      },
      "required": [
        "statementType",
        "predicateType",
        "subjects",
        "statementDigest",
        "envelopeFormat"
      ],
      "additionalProperties": false
    },
    "waiver": {
      "type": "object",
      "properties": {
        "decisionId": {
          "$ref": "#/$defs/Id"
        },
        "scope": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "owner": {
          "$ref": "#/$defs/Actor"
        },
        "expiresAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "compensatingControl": {
          "type": "string"
        },
        "reviewAt": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "decisionId",
        "scope",
        "reason",
        "owner",
        "expiresAt",
        "compensatingControl"
      ],
      "additionalProperties": false
    },
    "state": {
      "type": "string",
      "enum": [
        "MISSING",
        "PENDING",
        "CURRENT",
        "STALE",
        "CONFLICTING",
        "SUPERSEDED"
      ]
    },
    "supersededById": {
      "$ref": "#/$defs/Id"
    },
    "supersedesId": {
      "$ref": "#/$defs/Id"
    },
    "conflictsWith": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Id"
      }
    },
    "riskReviewId": {
      "$ref": "#/$defs/Id"
    },
    "recordedAt": {
      "$ref": "#/$defs/Timestamp"
    },
    "createdBy": {
      "$ref": "#/$defs/Actor"
    },
    "createdAt": {
      "$ref": "#/$defs/Timestamp"
    },
    "digest": {
      "$ref": "#/$defs/Digest",
      "description": "Equal to integrity.contentDigest."
    },
    "history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Transition"
      }
    }
  },
  "required": [
    "schemaVersion",
    "type",
    "id",
    "namespace",
    "evidenceKey",
    "category",
    "checkId",
    "criterionIds",
    "subject",
    "state",
    "createdAt",
    "createdBy"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "PENDING",
              "CURRENT",
              "STALE",
              "CONFLICTING",
              "SUPERSEDED"
            ]
          }
        }
      },
      "then": {
        "required": [
          "producer",
          "provenance"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "CURRENT",
              "STALE",
              "CONFLICTING",
              "SUPERSEDED"
            ]
          }
        }
      },
      "then": {
        "required": [
          "result",
          "integrity",
          "validity",
          "recordedAt",
          "digest",
          "independence"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "MISSING"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "result"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "WAIVED"
          }
        }
      },
      "then": {
        "required": [
          "waiver"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "CONFLICTING"
          }
        }
      },
      "then": {
        "required": [
          "conflictsWith"
        ],
        "properties": {
          "conflictsWith": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "SUPERSEDED"
          }
        }
      },
      "then": {
        "required": [
          "supersededById"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "STALE"
          }
        }
      },
      "then": {
        "properties": {
          "validity": {
            "required": [
              "staleReasons"
            ],
            "properties": {
              "staleReasons": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$",
      "description": "Instance identifier. Unique within the issuing namespace; combined with `namespace` it is globally unique."
    },
    "ArtifactUri": {
      "type": "string",
      "pattern": "^fdlc://v1/(intent|specification|plan|work-order|factory-manifest|factory-version|execution-profile|capability-manifest|qualification-record|context-package|attempt|candidate|evidence|verification|decision|release|outcome|learning-signal|improvement-candidate)(/[A-Za-z0-9][A-Za-z0-9._:@-]*)?$",
      "description": "Artifact type URI (`fdlc://v1/<artifact>`), optionally suffixed with an instance id."
    },
    "Namespace": {
      "type": "string",
      "format": "uri",
      "description": "URI of the issuing control plane or organization. Scopes every `id` in this record."
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "SHA-256 over the RFC 8785 (JCS) canonical JSON of the digested projection."
    },
    "GitSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$|^[a-f0-9]{64}$",
      "description": "Lowercase full Git object id (SHA-1 or SHA-256 repository)."
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 timestamp in UTC."
    },
    "Semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "RiskClass": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "AutonomyLevel": {
      "type": "string",
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3",
        "L4",
        "L5"
      ],
      "description": "HITL spectrum position. Effective autonomy is min(factory, objective, work order, policy, trust)."
    },
    "Actor": {
      "type": "object",
      "description": "Attributable identity. `identitySource` says how the control plane established it; never inferred from a client label.",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "human",
            "policy",
            "service",
            "agent",
            "system"
          ]
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "identitySource": {
          "type": "string",
          "enum": [
            "authenticated",
            "workload-identity",
            "service-command",
            "development-fallback"
          ]
        },
        "displayName": {
          "type": "string"
        },
        "delegationRef": {
          "$ref": "#/$defs/Id",
          "description": "Reference to the delegation record that grants this actor its authority."
        }
      },
      "required": [
        "kind",
        "id",
        "identitySource"
      ],
      "additionalProperties": false
    },
    "Ref": {
      "type": "object",
      "description": "Reference to another FDLC artifact instance, optionally pinned to a digest.",
      "properties": {
        "type": {
          "$ref": "#/$defs/ArtifactUri"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "revisionNumber": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false
    },
    "Money": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "additionalProperties": false
    },
    "CostRecord": {
      "type": "object",
      "description": "Cost with an honesty class. UNKNOWN cost stays UNKNOWN; implementations MUST NOT invent zeroes.",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "MEASURED",
            "ESTIMATED",
            "UNKNOWN"
          ]
        },
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Fraction of contributing cost items that were measured."
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    "Transition": {
      "type": "object",
      "description": "Audit record of one authoritative state transition. Every field listed here MUST be recorded.",
      "properties": {
        "transitionId": {
          "$ref": "#/$defs/Id"
        },
        "subjectId": {
          "$ref": "#/$defs/Id"
        },
        "priorVersion": {
          "type": "integer",
          "minimum": 0
        },
        "fromState": {
          "type": "string"
        },
        "toState": {
          "type": "string"
        },
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "reason": {
          "type": "string"
        },
        "policyVersion": {
          "type": "string"
        },
        "idempotencyKey": {
          "type": "string"
        },
        "occurredAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "requiredEvidenceIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "decisionId": {
          "$ref": "#/$defs/Id"
        },
        "invalidatedDependents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Ref"
          }
        }
      },
      "required": [
        "subjectId",
        "fromState",
        "toState",
        "actor",
        "reason",
        "idempotencyKey",
        "occurredAt"
      ],
      "additionalProperties": false
    },
    "ArtifactRef": {
      "type": "object",
      "description": "Content-addressed reference to a stored artifact (diff, log, screenshot, bundle).",
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "type": "string"
        },
        "mediaType": {
          "type": "string"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "storageRef": {
          "type": "string"
        }
      },
      "required": [
        "artifactId",
        "digest"
      ],
      "additionalProperties": false
    },
    "SubjectBinding": {
      "type": "object",
      "description": "Exact subject identity. Evidence bound to a different subject is not evidence for this one.",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "CANDIDATE",
            "RELEASE",
            "FACTORY_VERSION",
            "EXECUTION_PROFILE",
            "CAPABILITY",
            "ATTEMPT",
            "DECISION"
          ]
        },
        "candidateId": {
          "$ref": "#/$defs/Id"
        },
        "subjectDigest": {
          "$ref": "#/$defs/Digest"
        },
        "commitSha": {
          "$ref": "#/$defs/GitSha"
        },
        "treeSha": {
          "$ref": "#/$defs/GitSha"
        },
        "diffDigest": {
          "$ref": "#/$defs/Digest"
        },
        "contractDigest": {
          "$ref": "#/$defs/Digest",
          "description": "Verification contract digest the check was run under."
        },
        "sourceAttemptId": {
          "$ref": "#/$defs/Id"
        },
        "workOrderId": {
          "$ref": "#/$defs/Id"
        },
        "workOrderRevisionNumber": {
          "type": "integer",
          "minimum": 1
        },
        "subjectRef": {
          "$ref": "#/$defs/Ref",
          "description": "For non-candidate subjects (release, factory version, ...)."
        },
        "environmentDigest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "CANDIDATE"
              }
            }
          },
          "then": {
            "required": [
              "candidateId",
              "subjectDigest",
              "contractDigest",
              "sourceAttemptId",
              "workOrderId",
              "workOrderRevisionNumber"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "RELEASE",
                  "FACTORY_VERSION",
                  "EXECUTION_PROFILE",
                  "CAPABILITY",
                  "ATTEMPT",
                  "DECISION"
                ]
              }
            }
          },
          "then": {
            "required": [
              "subjectRef"
            ]
          }
        }
      ]
    },
    "ProducerBinding": {
      "type": "object",
      "description": "Who observed this. Evidence comes from the system performing the check, never from the system being checked.",
      "properties": {
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "role": {
          "type": "string",
          "enum": [
            "verifier",
            "producer",
            "control-plane",
            "provider",
            "human",
            "release-system",
            "observer"
          ]
        },
        "independent": {
          "type": "boolean"
        },
        "attemptId": {
          "$ref": "#/$defs/Id"
        },
        "factoryVersionId": {
          "$ref": "#/$defs/Id"
        },
        "factoryPurpose": {
          "type": "string",
          "enum": [
            "SOFTWARE",
            "VERIFICATION",
            "AUTOMATION"
          ]
        },
        "executorInvocationId": {
          "type": "string"
        },
        "leaseId": {
          "$ref": "#/$defs/Id"
        },
