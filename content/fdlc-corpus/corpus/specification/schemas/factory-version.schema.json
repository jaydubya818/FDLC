{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fdlc.ai/schemas/v1/factory-version.schema.json",
  "title": "FDLC Factory Version",
  "description": "Immutable, content-addressed composition of exact identities (planner, agent definitions, harness versions, skills, tools, model routes, runtime artifact, sandbox image, context config, verification config, approval requirements, policy bundle). Qualified per scope; activated per environment.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "type": {
      "type": "string",
      "const": "fdlc://v1/factory-version"
    },
    "id": {
      "$ref": "#/$defs/Id",
      "description": "FV-<factory>-<semver>."
    },
    "namespace": {
      "$ref": "#/$defs/Namespace"
    },
    "factoryManifestId": {
      "$ref": "#/$defs/Id"
    },
    "factoryManifestDigest": {
      "$ref": "#/$defs/Digest"
    },
    "factoryName": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "version": {
      "$ref": "#/$defs/Semver"
    },
    "purpose": {
      "type": "string",
      "enum": [
        "SOFTWARE",
        "VERIFICATION",
        "AUTOMATION"
      ]
    },
    "riskBoundary": {
      "$ref": "#/$defs/RiskClass"
    },
    "composition": {
      "type": "object",
      "description": "Every component pinned to an exact version and digest. Nothing here may float.",
      "properties": {
        "planner": {
          "$ref": "#/$defs/Component"
        },
        "agentDefinitions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/AgentComponent"
          }
        },
        "harnesses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/HarnessComponent"
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Component"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToolComponent"
          }
        },
        "modelRoutes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ModelRouteComponent"
          }
        },
        "contextConfiguration": {
          "type": "object",
          "properties": {
            "sources": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Component"
              }
            },
            "policyDigest": {
              "$ref": "#/$defs/Digest"
            },
            "freshnessMaxAgeHours": {
              "type": "integer",
              "minimum": 1
            },
            "digest": {
              "$ref": "#/$defs/Digest"
            }
          },
          "required": [
            "sources",
            "policyDigest",
            "digest"
          ],
          "additionalProperties": false
        },
        "workGraph": {
          "type": "object",
          "properties": {
            "workflowId": {
              "type": "string"
            },
            "version": {
              "type": "integer",
              "minimum": 1
            },
            "digest": {
              "$ref": "#/$defs/Digest"
            }
          },
          "required": [
            "workflowId",
            "version",
            "digest"
          ],
          "additionalProperties": false
        },
        "runtimeArtifact": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "EXECUTABLE",
                "CONTAINER_IMAGE"
              ]
            },
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "digest": {
              "$ref": "#/$defs/Digest"
            },
            "closureDigest": {
              "$ref": "#/$defs/Digest"
            }
          },
          "required": [
            "kind",
            "name",
            "version",
            "digest"
          ],
          "additionalProperties": false
        },
        "sandboxImage": {
          "type": "object",
          "properties": {
            "reference": {
              "type": "string"
            },
            "digest": {
              "$ref": "#/$defs/Digest"
            },
            "profileDigest": {
              "$ref": "#/$defs/Digest"
            }
          },
          "required": [
            "digest",
            "profileDigest"
          ],
          "additionalProperties": false
        },
        "networkPolicy": {
          "$ref": "#/$defs/PolicyDigest"
        },
        "credentialPolicy": {
          "$ref": "#/$defs/PolicyDigest"
        },
        "filesystemPolicy": {
          "$ref": "#/$defs/PolicyDigest"
        },
        "verificationContract": {
          "$ref": "#/$defs/PolicyDigest"
        },
        "approvalPolicy": {
          "$ref": "#/$defs/PolicyDigest"
        },
        "policyBundle": {
          "$ref": "#/$defs/PolicyDigest"
        },
        "executionProfiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "executionProfileId": {
                "$ref": "#/$defs/Id"
              },
              "digest": {
                "$ref": "#/$defs/Digest"
              },
              "key": {
                "type": "string"
              }
            },
            "required": [
              "executionProfileId",
              "digest"
            ],
            "additionalProperties": false
          }
        },
        "economics": {
          "type": "object",
          "properties": {
            "maxCostPerWorkOrder": {
              "$ref": "#/$defs/Money"
            },
            "maxAttempts": {
              "type": "integer",
              "minimum": 1
            },
            "maxRuntimeMinutes": {
              "type": "integer",
              "minimum": 1
            },
            "digest": {
              "$ref": "#/$defs/Digest"
            }
          },
          "required": [
            "maxCostPerWorkOrder",
            "maxAttempts",
            "maxRuntimeMinutes",
            "digest"
          ],
          "additionalProperties": false
        },
        "verifierBindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Component"
          }
        }
      },
      "required": [
        "planner",
        "agentDefinitions",
        "harnesses",
        "skills",
        "tools",
        "modelRoutes",
        "contextConfiguration",
        "workGraph",
        "runtimeArtifact",
        "sandboxImage",
        "networkPolicy",
        "credentialPolicy",
        "filesystemPolicy",
        "verificationContract",
        "approvalPolicy",
        "policyBundle",
        "executionProfiles",
        "economics"
      ],
      "additionalProperties": false
    },
    "compositionDigest": {
      "$ref": "#/$defs/Digest",
      "description": "Digest over the sorted set of every component digest in `composition`. This is the content address of the Factory Version."
    },
    "qualification": {
      "type": "object",
      "properties": {
        "standardVersion": {
          "type": "string"
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "qualificationRecordId": {
                "$ref": "#/$defs/Id"
              },
              "digest": {
                "$ref": "#/$defs/Digest"
              },
              "scope": {
                "$ref": "#/$defs/QualificationScope"
              },
              "result": {
                "type": "string",
                "enum": [
                  "QUALIFIED",
                  "REJECTED",
                  "EXPIRED",
                  "REVOKED"
                ]
              },
              "expiresAt": {
                "$ref": "#/$defs/Timestamp"
              }
            },
            "required": [
              "qualificationRecordId",
              "scope",
              "result"
            ],
            "additionalProperties": false
          }
        },
        "qualifiedScopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QualificationScope"
          }
        }
      },
      "required": [
        "standardVersion",
        "records",
        "qualifiedScopes"
      ],
      "additionalProperties": false
    },
    "activations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Activation"
      }
    },
    "state": {
      "type": "string",
      "enum": [
        "DRAFT",
        "CANDIDATE",
        "QUALIFIED",
        "ACTIVE",
        "RESTRICTED",
        "SUSPENDED",
        "DEPRECATED",
        "RETIRED",
        "REJECTED"
      ]
    },
    "restriction": {
      "type": "object",
      "properties": {
        "narrowedScopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QualificationScope"
          }
        },
        "reason": {
          "type": "string"
        },
        "decisionId": {
          "$ref": "#/$defs/Id"
        },
        "restrictedAt": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "narrowedScopes",
        "reason",
        "decisionId",
        "restrictedAt"
      ],
      "additionalProperties": false
    },
    "suspension": {
      "type": "object",
      "properties": {
        "incidentId": {
          "$ref": "#/$defs/Id"
        },
        "reason": {
          "type": "string"
        },
        "suspendedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "restorationDecisionId": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "reason",
        "suspendedAt"
      ],
      "additionalProperties": false
    },
    "previousVersionId": {
      "$ref": "#/$defs/Id"
    },
    "supersededByVersionId": {
      "$ref": "#/$defs/Id"
    },
    "improvementCandidateId": {
      "$ref": "#/$defs/Id",
      "description": "The Improvement Candidate this version was assembled from, if any."
    },
    "readiness": {
      "type": "object",
      "description": "Configuration readiness (admissibility), derived, expiring. Distinct from behavioral qualification.",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "BLOCKED"
          ]
        },
        "assessedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "expiresAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "VERIFIED",
                  "MISSING",
                  "STALE",
                  "WAIVED",
                  "NOT_APPLICABLE"
                ]
              },
              "remediation": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "status"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "status",
        "assessedAt",
        "expiresAt",
        "checks"
      ],
      "additionalProperties": false
    },
    "digest": {
      "$ref": "#/$defs/Digest",
      "description": "Digest over (id, factoryManifestDigest, version, purpose, compositionDigest)."
    },
    "createdAt": {
      "$ref": "#/$defs/Timestamp"
    },
    "createdBy": {
      "$ref": "#/$defs/Actor"
    },
    "history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Transition"
      }
    }
  },
  "required": [
    "schemaVersion",
    "type",
    "id",
    "namespace",
    "factoryManifestId",
    "factoryManifestDigest",
    "factoryName",
    "version",
    "purpose",
    "riskBoundary",
    "composition",
    "compositionDigest",
    "qualification",
    "activations",
    "state",
    "digest",
    "createdAt",
    "createdBy"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "QUALIFIED",
              "ACTIVE",
              "RESTRICTED",
              "SUSPENDED",
              "DEPRECATED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "qualification": {
            "properties": {
              "records": {
                "minItems": 1
              },
              "qualifiedScopes": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "ACTIVE",
              "RESTRICTED",
              "SUSPENDED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "activations": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "RESTRICTED"
          }
        }
      },
      "then": {
        "required": [
          "restriction"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "SUSPENDED"
          }
        }
      },
      "then": {
        "required": [
          "suspension"
        ]
      }
    }
  ],
  "$defs": {
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$",
      "description": "Instance identifier. Unique within the issuing namespace; combined with `namespace` it is globally unique."
    },
    "ArtifactUri": {
      "type": "string",
      "pattern": "^fdlc://v1/(intent|specification|plan|work-order|factory-manifest|factory-version|execution-profile|capability-manifest|qualification-record|context-package|attempt|candidate|evidence|verification|decision|release|outcome|learning-signal|improvement-candidate)(/[A-Za-z0-9][A-Za-z0-9._:@-]*)?$",
      "description": "Artifact type URI (`fdlc://v1/<artifact>`), optionally suffixed with an instance id."
    },
    "Namespace": {
      "type": "string",
      "format": "uri",
      "description": "URI of the issuing control plane or organization. Scopes every `id` in this record."
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "SHA-256 over the RFC 8785 (JCS) canonical JSON of the digested projection."
    },
    "GitSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$|^[a-f0-9]{64}$",
      "description": "Lowercase full Git object id (SHA-1 or SHA-256 repository)."
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 timestamp in UTC."
    },
    "Semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "RiskClass": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "AutonomyLevel": {
      "type": "string",
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3",
        "L4",
        "L5"
      ],
      "description": "HITL spectrum position. Effective autonomy is min(factory, objective, work order, policy, trust)."
    },
    "Actor": {
      "type": "object",
      "description": "Attributable identity. `identitySource` says how the control plane established it; never inferred from a client label.",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "human",
            "policy",
            "service",
            "agent",
            "system"
          ]
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "identitySource": {
          "type": "string",
          "enum": [
            "authenticated",
            "workload-identity",
            "service-command",
            "development-fallback"
          ]
        },
        "displayName": {
          "type": "string"
        },
        "delegationRef": {
          "$ref": "#/$defs/Id",
          "description": "Reference to the delegation record that grants this actor its authority."
        }
      },
      "required": [
        "kind",
        "id",
        "identitySource"
      ],
      "additionalProperties": false
    },
    "Ref": {
      "type": "object",
      "description": "Reference to another FDLC artifact instance, optionally pinned to a digest.",
      "properties": {
        "type": {
          "$ref": "#/$defs/ArtifactUri"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "revisionNumber": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false
    },
    "Money": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "additionalProperties": false
    },
    "CostRecord": {
      "type": "object",
      "description": "Cost with an honesty class. UNKNOWN cost stays UNKNOWN; implementations MUST NOT invent zeroes.",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "MEASURED",
            "ESTIMATED",
            "UNKNOWN"
          ]
        },
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Fraction of contributing cost items that were measured."
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    "Transition": {
      "type": "object",
      "description": "Audit record of one authoritative state transition. Every field listed here MUST be recorded.",
      "properties": {
        "transitionId": {
          "$ref": "#/$defs/Id"
        },
        "subjectId": {
          "$ref": "#/$defs/Id"
        },
        "priorVersion": {
          "type": "integer",
          "minimum": 0
        },
        "fromState": {
          "type": "string"
        },
        "toState": {
          "type": "string"
        },
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "reason": {
          "type": "string"
        },
        "policyVersion": {
          "type": "string"
        },
        "idempotencyKey": {
          "type": "string"
        },
        "occurredAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "requiredEvidenceIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "decisionId": {
          "$ref": "#/$defs/Id"
        },
        "invalidatedDependents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Ref"
          }
        }
      },
      "required": [
        "subjectId",
        "fromState",
        "toState",
        "actor",
        "reason",
        "idempotencyKey",
        "occurredAt"
      ],
      "additionalProperties": false
    },
    "ArtifactRef": {
      "type": "object",
      "description": "Content-addressed reference to a stored artifact (diff, log, screenshot, bundle).",
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "type": "string"
        },
        "mediaType": {
          "type": "string"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "storageRef": {
          "type": "string"
        }
      },
      "required": [
        "artifactId",
        "digest"
      ],
      "additionalProperties": false
    },
    "Component": {
      "type": "object",
      "properties": {
        "capabilityId": {
          "$ref": "#/$defs/Id"
        },
        "version": {
          "type": "string"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "role": {
          "type": "string"
        }
      },
      "required": [
        "capabilityId",
        "version",
        "digest"
      ],
      "additionalProperties": false
    },
    "AgentComponent": {
      "type": "object",
      "properties": {
        "capabilityId": {
          "$ref": "#/$defs/Id"
        },
        "version": {
          "type": "string"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "role": {
          "type": "string"
        },
        "promptBundleDigest": {
          "$ref": "#/$defs/Digest"
        },
        "toolManifestDigest": {
          "$ref": "#/$defs/Digest"
        },
        "modelRouteId": {
          "type": "string"
        }
      },
      "required": [
        "capabilityId",
        "version",
        "digest",
        "role",
        "promptBundleDigest",
        "toolManifestDigest",
        "modelRouteId"
      ],
      "additionalProperties": false
    },
    "HarnessComponent": {
      "type": "object",
      "properties": {
        "capabilityId": {
          "$ref": "#/$defs/Id"
        },
        "version": {
          "type": "string"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "adapterId": {
          "type": "string"
        },
        "adapterVersion": {
          "type": "string"
        },
        "capabilityManifestDigest": {
          "$ref": "#/$defs/Digest"
        },
        "effectiveConfigDigest": {
          "$ref": "#/$defs/Digest"
        },
        "runtimeArtifactDigest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "capabilityId",
        "version",
        "digest",
        "adapterId",
        "adapterVersion",
        "capabilityManifestDigest",
        "effectiveConfigDigest",
        "runtimeArtifactDigest"
      ],
      "additionalProperties": false
    },
    "ToolComponent": {
      "type": "object",
      "properties": {
        "capabilityId": {
          "$ref": "#/$defs/Id"
        },
        "version": {
          "type": "string"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "grantId": {
          "$ref": "#/$defs/Id"
        },
        "grantDigest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "capabilityId",
        "version",
        "digest",
        "operations",
        "grantId",
        "grantDigest"
      ],
      "additionalProperties": false
    },
    "ModelRouteComponent": {
      "type": "object",
      "properties": {
        "routeId": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "PLAN",
            "IMPLEMENT",
            "TRANSFORM",
            "VERIFY",
            "REVIEW"
          ]
        },
        "provider": {
          "type": "string"
        },
        "modelId": {
          "type": "string"
        },
        "reasoningConfig": {
          "type": "object",
          "properties": {
            "temperature": {
              "type": "number"
            },
            "maxTokens": {
              "type": "integer"
            },
            "effort": {
              "type": "string"
            }
