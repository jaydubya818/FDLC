{
  "name": "fdlc-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "corpus:sync": "node --experimental-strip-types scripts/corpus/taxonomy.ts --write && node --experimental-strip-types scripts/corpus/generate.ts --write",
    "corpus:verify": "node --experimental-strip-types scripts/corpus/taxonomy.ts --check && node --experimental-strip-types scripts/corpus/generate.ts --check",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "prebuild": "npm run corpus:verify",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "microfrontends:check": "node scripts/check-microfrontends-config.mjs",
    "prebuild:vercel": "npm run corpus:verify && npm run microfrontends:check",
    "build:vercel": "next build",
    "postbuild:vercel": "node scripts/check-built-design-system.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:unit && npm run build && node --test tests/rendered-html.test.mjs",
    "pretest:next": "npm run corpus:verify",
    "test:next": "next build --webpack && npm run test:next-runtime",
    "test:next-runtime": "node scripts/check-next-runtime.mjs",
    "pretest:unit": "npm run corpus:verify && npm run shell:check",
    "test:unit": "node --experimental-strip-types --test tests/unit/**/*.test.ts",
    "pretypecheck": "npm run corpus:verify",
    "typecheck": "next typegen && tsc --noEmit && npm run typecheck --prefix packages/fab",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test:browser": "node tests/browser.mjs",
    "test:browser:vercel": "node tests/browser.mjs next",
    "pretest:corpus-browser": "npm run corpus:verify",
    "test:corpus-browser": "node tests/corpus-browser.mjs",
    "pretest:corpus-browser:vercel": "npm run corpus:verify",
    "test:corpus-browser:vercel": "node tests/corpus-browser.mjs next",
    "shell:check": "node scripts/sync-ai-fde-shell.mjs --check",
    "starter:pack": "python3 scripts/package-factory-starter.py",
    "starter:check": "python3 scripts/package-factory-starter.py --check",
    "starter:test": "node --test factory-starter/test/*.test.mjs"
  },
  "dependencies": {
    "@vercel/microfrontends": "2.4.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "github-slugger": "2.0.0",
    "gray-matter": "4.0.3",
    "mermaid": "11.17.2",
    "next": "16.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "axe-core": "4.12.1",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "playwright": "1.62.1",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.9",
    "vite": "8.2.4",
    "wrangler": "4.151.0"
  },
  "overrides": {
    "lodash-es": "4.18.1",
    "undici": "7.30.1"
  },
  "type": "module"
}
